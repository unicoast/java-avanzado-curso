<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Solo mostrar si ocurre un ERROR crítico de conexión en Hikari -->
    <logger name="com.zaxxer.hikari" level="ERROR" />

    <!-- La raíz solo reporta errores, manteniendo la pantalla despejada para el menú -->
    <root level="ERROR">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
